---
import Header from "@/components/Header.astro";
import GameApp from "@/components/GameApp.astro";
import { URL_BASE } from "@/config";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div class="min-h-screen flex flex-col relative bg-linear-180 from-[#AA0061] to-[#FF6900]">
    <div class="absolute top-0 left-0 right-0 z-10">
      <Header dayapoints="white" />
    </div>
    <main>
      <GameApp />
    </main>
  </div>
</Layout>
