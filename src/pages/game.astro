---
import Header from "@/components/Header.astro";
import { URL_BASE } from "@/config";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div class="min-h-screen flex flex-col relative" style={`background-image: url(${URL_BASE}/images/bg_game.webp); background-size: cover; background-position: center;`}>
    <div class="absolute top-0 left-0 right-0 z-10">
      <Header dayapoints="white" />
    </div>
    <main class="w-full flex-1 flex flex-col lg:flex-row">
      
    </main>
  </div>
</Layout>
