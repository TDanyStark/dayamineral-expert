---
import { URL_BASE } from "@/config";
---

<script is:inline define:vars={{ URL_BASE }}>
  window.__URL_BASE__ = URL_BASE;
</script>

<section
  id="game-root"
  class="relative w-full min-h-screen pt-28 pb-8 px-4"
>
  <!-- Status bar -->
  <div
    class="relative z-20 max-w-7xl mx-auto mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-3"
  >
    <div class="flex items-center gap-4 text-white">
      <div
        id="game-score-pill"
        class="bg-white/15 backdrop-blur-md border border-white/20 rounded-full px-5 py-2 transition-colors"
      >
        <span class="text-sm md:text-base font-light">DAYAPOINTS:</span>
        <span
          class="text-lg md:text-xl font-bold ml-1 inline-block min-w-[3.5ch] text-center"
          id="game-score">000</span>
      </div>
      <div
        class="bg-white/15 backdrop-blur-md border border-white/20 rounded-full px-5 py-2"
      >
        <span class="text-sm md:text-base font-light">FALTAN:</span>
        <span class="text-lg md:text-xl font-bold ml-1" id="game-remaining">15</span>
      </div>
      <div
        class="bg-white/15 backdrop-blur-md border border-white/20 rounded-full px-5 py-2"
      >
        <span class="text-sm md:text-base font-light">ENCONTRADOS:</span>
        <span class="text-lg md:text-xl font-bold ml-1" id="game-found">0</span>/8
      </div>
    </div>
    <div class="flex justify-between lg:justify-end items-center gap-3">
      <button
        id="game-btn-restart"
        type="button"
        class="text-white text-sm md:text-base font-bold py-2 px-5 rounded-full bg-white/15 hover:bg-white/25 backdrop-blur-md border border-white/30 transition"
      >
        REINICIAR
      </button>
      <button
        id="game-btn-finish"
        type="button"
        disabled
        class="text-white text-sm md:text-base font-bold py-2 px-5 rounded-full bg-linear-(--gradient-purple) opacity-50 disabled:cursor-not-allowed hover:opacity-100 enabled:opacity-100 transition"
      >
        FINALIZAR
      </button>
    </div>
  </div>

  <!-- Playfield -->
  <div
    id="game-playfield"
    class="relative w-full max-w-7xl mx-auto flex flex-col items-center gap-3 md:block md:gap-0"
    style="min-height: 60vh;"
  >
  </div>

  <!-- References (game screen) -->
  <p class="w-full max-w-7xl mx-auto mt-8 text-white text-xs leading-snug">
    <span class="font-bold">Referencias</span>
    <span class="font-bold">1.</span> Garg V, Lin J, Gadzhieva-Moore A, et al. The role of multivitamin and mineral supplements in supporting health and well-being: a retrospective cross-sectional study in Taiwan. J Health Popul Nutr. 2025;44(1):423.
    <span class="font-bold">2.</span> Harvard Health Publishing. Making sense of vitamins and minerals: choosing the foods and nutrients you need to stay healthy [Internet]. Boston (MA): Harvard Medical School; 2022. Disponible en: https://n9.cl/peog1
    <span class="font-bold">3.</span> Office of Dietary Supplements. Choline: fact sheet for health professionals [Internet]. Bethesda (MD): National Institutes of Health; 2024. Disponible en: https://n9.cl/du2tx
    <span class="font-bold">4.</span> Meixner M. Inositol: benefits, side effects and dosage [Internet]. Healthline; 2023. Disponible en: https://n9.cl/8wm3v
  </p>

  <!-- Hidden audio -->
  <audio id="game-audio-win" src={`${URL_BASE}/sounds/confetti.mp3`} preload="auto"></audio>
  <audio id="game-audio-fail" src={`${URL_BASE}/sounds/fail.mp3`} preload="auto"></audio>

  <!-- Final modal -->
  <div
    id="game-final-modal"
    class="fixed inset-0 z-50 hidden bg-black/70"
  >
    <div
      class="absolute inset-0 bg-no-repeat bg-cover bg-center"
      style={`background-image: url(${URL_BASE}/images/bg_end.webp);`}
    >
    </div>

    <div class="relative z-10 w-full h-full flex flex-col">
      <!-- modal header -->
      <div class="w-7xl max-w-full mx-auto p-4 md:p-6 flex justify-between items-center">
        <a href={URL_BASE} class="flex items-center gap-6">
          <img
          src={`${URL_BASE}/logos/abbott_white.webp`}
          alt="Logo Abbott"
          class="w-24 md:w-32"
        />
        </a>
        <img
          src={`${URL_BASE}/logos/logo_dayamineral_color.webp`}
          alt="Logo Dayamineral"
          class="w-32 md:w-44"
        />
      </div>

      <!-- modal content -->
      <div
        class="flex-1 flex items-center justify-center md:justify-end px-6 md:pr-16 lg:pr-24"
      >
        <div class="flex flex-col items-center w-full max-w-xl text-white text-center md:text-left">
          <div class="mb-4 md:mb-6">
            <span
              id="game-final-badge"
              class="flex flex-col items-center gap-3 bg-linear-(--gradient-purple) text-white font-bold text-center rounded-full text-2xl md:text-4xl py-4 px-10"
            >
              <img
                src={`${URL_BASE}/iconos/icon_padlock.webp`}
                alt="badge icon"
                class="w-10 h-auto"
              />
              <span id="game-final-tier">DAYAMINERAL EXPERT</span>
            </span>
          </div>
          <p
            id="game-final-description"
            class="text-lg text-center md:text-2xl uppercase leading-snug mb-4 text-black"
          >
          </p>
          <p class="text-xl text-center md:text-2xl font-bold mb-6 text-black">
            DAYAPOINTS: <span id="game-final-score">0</span>
          </p>
          <button
            id="game-btn-replay"
            type="button"
            class="text-white text-xl md:text-2xl font-bold py-3 px-6 rounded-full bg-linear-(--gradient-purple) transition-transform transform hover:scale-105"
          >
            JUGAR DE NUEVO
          </button>
        </div>
      </div>

      <!-- References (modal) -->
      <p class="w-full max-w-7xl mx-auto px-4 md:px-6 pb-4 text-white text-xs leading-snug">
        <span class="font-bold">Referencias</span>
        <span class="font-bold">1.</span> Garg V, Lin J, Gadzhieva-Moore A, et al. The role of multivitamin and mineral supplements in supporting health and well-being: a retrospective cross-sectional study in Taiwan. J Health Popul Nutr. 2025;44(1):423.
        <span class="font-bold">2.</span> Harvard Health Publishing. Making sense of vitamins and minerals: choosing the foods and nutrients you need to stay healthy [Internet]. Boston (MA): Harvard Medical School; 2022. Disponible en: https://n9.cl/peog1
        <span class="font-bold">3.</span> Office of Dietary Supplements. Choline: fact sheet for health professionals [Internet]. Bethesda (MD): National Institutes of Health; 2024. Disponible en: https://n9.cl/du2tx
        <span class="font-bold">4.</span> Meixner M. Inositol: benefits, side effects and dosage [Internet]. Healthline; 2023. Disponible en: https://n9.cl/8wm3v
      </p>
    </div>
  </div>
</section>

<style is:global>
  #game-score-pill.score-negative {
    background: rgba(220, 38, 38, 0.55) !important;
    border-color: rgba(255, 255, 255, 0.6) !important;
    color: #ffffff;
    box-shadow: 0 0 0 1px rgba(255, 80, 80, 0.4), 0 6px 18px rgba(220, 38, 38, 0.35);
  }
  #game-score-pill.score-negative #game-score {
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .game-bubble {
    width: 15rem;
    height: 7.5rem;
    border-radius: 1.5rem;
    opacity: 0;
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      inset 0 -1px 0 rgba(255, 255, 255, 0.08),
      0 8px 24px rgba(0, 0, 0, 0.18);
    color: #ffffff;
    padding: 0.85rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    cursor: pointer;
    user-select: none;
    text-transform: uppercase;
    font-family: "Brandon", sans-serif;
    font-size: 0.82rem;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: 0.01em;
    overflow: hidden;
    will-change: transform, opacity;
  }

  /* Bubble grow-in: opacity + scale with elastic settle, like a real soap bubble forming. */
  @keyframes game-bubble-spawn {
    0% {
      opacity: 0;
      transform: translate3d(var(--bx, 0), var(--by, 0), 0) scale(0.2);
      filter: blur(4px);
    }
    55% {
      opacity: 1;
      transform: translate3d(var(--bx, 0), var(--by, 0), 0) scale(1.08);
      filter: blur(0);
    }
    78% {
      transform: translate3d(var(--bx, 0), var(--by, 0), 0) scale(0.96);
    }
    100% {
      opacity: 1;
      transform: translate3d(var(--bx, 0), var(--by, 0), 0) scale(1);
      filter: blur(0);
    }
  }

  .game-bubble.placed {
    opacity: 1;
    animation: game-bubble-spawn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  /* After spawn animation finishes, we set this class so JS-driven transforms aren't fighting CSS animation. */
  .game-bubble.alive {
    animation: none;
    opacity: 1;
  }

  .game-bubble:hover {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.45),
      0 12px 30px rgba(0, 0, 0, 0.25);
  }

  .game-bubble.variant-1 {
    background: linear-gradient(135deg, rgba(253, 0, 21, 0.32), rgba(255, 255, 255, 0.14));
  }
  .game-bubble.variant-2 {
    background: linear-gradient(135deg, rgba(174, 0, 97, 0.36), rgba(255, 255, 255, 0.12));
  }
  .game-bubble.variant-3 {
    background: linear-gradient(135deg, rgba(222, 138, 23, 0.28), rgba(174, 0, 97, 0.22));
  }
  .game-bubble.variant-4 {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.22), rgba(174, 0, 97, 0.16));
  }

  .game-bubble .bubble-icon {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.25));
  }

  .game-bubble .bubble-text {
    flex: 1;
    color: #ffffff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  }

  .game-bubble.feedback-win {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.6), rgba(34, 197, 94, 0.28));
    border-color: rgba(255, 255, 255, 0.6);
  }
  .game-bubble.feedback-lose {
    background: linear-gradient(135deg, rgba(253, 0, 21, 0.6), rgba(174, 0, 97, 0.4));
    border-color: rgba(255, 255, 255, 0.6);
  }

  .game-bubble.feedback-content {
    justify-content: center;
    text-align: center;
  }

  .game-bubble.feedback-content .bubble-text {
    font-size: 1.05rem;
    font-weight: 900;
    letter-spacing: 0.02em;
  }

  .game-bubble.removing {
    animation: none;
    opacity: 0;
    transform: translate3d(var(--bx, 0), var(--by, 0), 0) scale(0.7);
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Tablet (iPad) free-floating: smaller bubbles + taller playfield to give breathing room */
  @media (min-width: 768px) and (max-width: 1279px) {
    #game-playfield {
      height: auto;
      min-height: 900px;
    }
    .game-bubble {
      position: absolute;
      top: 0;
      left: 0;
      width: 12.5rem;
      height: 6.75rem;
      font-size: 0.74rem;
      padding: 0.7rem 0.85rem;
    }
    .game-bubble .bubble-icon {
      width: 1.65rem;
      height: 1.65rem;
    }
    .game-bubble.feedback-content .bubble-text {
      font-size: 0.92rem;
    }
  }

  /* Desktop free-floating */
  @media (min-width: 1280px) {
    #game-playfield {
      height: 70vh;
      min-height: 560px;
    }
    .game-bubble {
      position: absolute;
      top: 0;
      left: 0;
    }
  }

  /* Mobile column */
  @media (max-width: 767px) {
    .game-bubble {
      position: relative;
      transform: none !important;
      width: 90%;
      max-width: 22rem;
    }
  }
</style>

<script>
  import confetti from "canvas-confetti";

  type Benefit = { text: string; points: number; real: boolean };

  const REAL: Benefit[] = [
    { text: "TRIPLE IMPULSO (ENERGÍA, VITALIDAD, DESEMPEÑO FÍSICO Y MENTAL).", points: 18, real: true },
    { text: "FORTALECE LAS DEFENSAS DE LOS NIÑOS.", points: 15, real: true },
    { text: "MEJORA EL DESARROLLO FÍSICO Y CEREBRAL DE LOS NIÑOS.", points: 15, real: true },
    { text: "MEJORA MEMORIA Y CONCENTRACIÓN.", points: 12, real: true },
    { text: "AUMENTA METABOLISMO Y OXIGENACIÓN.", points: 12, real: true },
    { text: "MEJORA RENDIMIENTO FÍSICO.", points: 10, real: true },
    { text: "MANTIENE ÓPTIMAS LAS FUNCIONES INMUNE Y MUSCULAR.", points: 10, real: true },
    { text: "BENEFICIOS SIN AUMENTO DE PESO.", points: 8, real: true },
  ];

  const FAKE: Benefit[] = [
    { text: "PERMITE QUE LOS NIÑOS HAGAN TAREAS SIN PROTESTAR.", points: -8, real: false },
    { text: "AUMENTA LA VELOCIDAD PARA APRENDER A MONTAR BICICLETA.", points: -7, real: false },
    { text: "HACE QUE LOS ALIMENTOS SEPAN MÁS DELICIOSOS.", points: -7, real: false },
    { text: "PERMITE QUE LOS NIÑOS NUNCA SE RESFRÍEN.", points: -10, real: false },
    { text: "MEJORA LA HABILIDAD PARA GANAR VIDEOJUEGOS.", points: -8, real: false },
    { text: "HACE QUE LAS REUNIONES LABORALES SEAN MÁS EFICIENTES.", points: -5, real: false },
    { text: "POTENCIALIZA LOS EFECTOS DEL CAFÉ PARA EVITAR EL SUEÑO EN LAS TARDES.", points: -5, real: false },
  ];

  const MAX_VISIBLE = 8;
  const URL_BASE = (window as any).__URL_BASE__ ?? "/apps/abbott/dayamineral-expert";
  const ICON_TOUCH = `${URL_BASE}/iconos/icon_touch.webp`;

  // Bubble dimensions must match CSS .game-bubble (responsive by breakpoint)
  function bubbleSize(): { w: number; h: number } {
    const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
    const w = window.innerWidth;
    if (w >= 1280) return { w: 15 * rem, h: 7.5 * rem };
    if (w >= 768) return { w: 12.5 * rem, h: 6.75 * rem }; // tablet
    return { w: 15 * rem, h: 7.5 * rem }; // mobile column (size irrelevant for physics)
  }

  type ActiveBubble = {
    el: HTMLDivElement;
    benefit: Benefit;
    x: number;
    y: number;
    vx: number;
    vy: number;
    w: number;
    h: number;
    paused: boolean;
    locked: boolean;
    spawning: boolean;
  };

  const state = {
    pool: [] as Benefit[],
    active: [] as ActiveBubble[],
    score: 0,
    found: 0,
    interactionStarted: false,
    rafId: 0,
    isDesktop: false,
  };

  const playfield = document.getElementById("game-playfield") as HTMLDivElement;
  const scoreEl = document.getElementById("game-score") as HTMLSpanElement;
  const scorePill = document.getElementById("game-score-pill") as HTMLDivElement | null;
  const remainingEl = document.getElementById("game-remaining") as HTMLSpanElement;
  const foundEl = document.getElementById("game-found") as HTMLSpanElement;
  const btnRestart = document.getElementById("game-btn-restart") as HTMLButtonElement;
  const btnFinish = document.getElementById("game-btn-finish") as HTMLButtonElement;
  const btnReplay = document.getElementById("game-btn-replay") as HTMLButtonElement;
  const modal = document.getElementById("game-final-modal") as HTMLDivElement;
  const tierEl = document.getElementById("game-final-tier") as HTMLSpanElement;
  const descEl = document.getElementById("game-final-description") as HTMLParagraphElement;
  const finalScoreEl = document.getElementById("game-final-score") as HTMLSpanElement;
  const audioWin = document.getElementById("game-audio-win") as HTMLAudioElement;
  const audioFail = document.getElementById("game-audio-fail") as HTMLAudioElement;

  // Make sure audio is unlocked by the first user gesture.
  // Some mobile/desktop browsers require a user-initiated .play() at least once.
  let audioUnlocked = false;
  function unlockAudio() {
    if (audioUnlocked) return;
    audioUnlocked = true;
    [audioWin, audioFail].forEach((a) => {
      if (!a) return;
      try {
        a.volume = 1;
        a.muted = true;
        const p = a.play();
        if (p && typeof p.then === "function") {
          p.then(() => {
            a.pause();
            a.currentTime = 0;
            a.muted = false;
          }).catch(() => {
            a.muted = false;
          });
        } else {
          a.pause();
          a.currentTime = 0;
          a.muted = false;
        }
      } catch {}
    });
  }
  // Unlock on the first interaction anywhere in the game.
  ["pointerdown", "touchstart", "keydown"].forEach((evt) =>
    window.addEventListener(evt, unlockAudio, { once: true, passive: true }),
  );

  function playSound(audio: HTMLAudioElement) {
    if (!audio) return;
    try {
      audio.pause();
      audio.currentTime = 0;
      const p = audio.play();
      if (p && typeof p.catch === "function") {
        p.catch((err) => {
          // Helpful in dev to detect autoplay or decoding issues
          console.warn("[game] audio play failed", err);
        });
      }
    } catch (e) {
      console.warn("[game] audio play threw", e);
    }
  }

  const BRAND_COLORS = ["#de8a17", "#fd0015", "#ae0061", "#ffffff"];

  function shuffle<T>(arr: T[]): T[] {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function updateScoreUI() {
    const value = state.score;
    if (value < 0) {
      scoreEl.textContent = "-" + String(Math.abs(value)).padStart(3, "0");
      scorePill?.classList.add("score-negative");
    } else {
      scoreEl.textContent = String(value).padStart(3, "0");
      scorePill?.classList.remove("score-negative");
    }
  }

  function updateRemainingUI() {
    const total = state.pool.length + state.active.length;
    remainingEl.textContent = String(total);
  }

  function updateFoundUI() {
    foundEl.textContent = String(state.found);
  }

  function tierForScore(score: number): { tier: string; desc: string } {
    if (score >= 100) {
      return {
        tier: "DAYAMINERAL EXPERT",
        desc: "DOMINIO TOTAL. CONOCE A LA PERFECCIÓN LOS BENEFICIOS QUE LE BRINDA DAYAMINERAL.",
      };
    }
    if (score >= 61) {
      return {
        tier: "DAYAMINERAL ADVANCED",
        desc: "DEMUESTRA UN CONOCIMIENTO AVANZADO. ESTÁ MUY CERCA DE LLEGAR AL NIVEL EXPERT.",
      };
    }
    if (score >= 31) {
      return {
        tier: "DAYAMINERAL MEDIUM",
        desc: "TIENE UNA BUENA BASE, AUNQUE TODAVÍA SE LE ESCAPAN DETALLES CLAVE. VA POR MUY BUEN CAMINO.",
      };
    }
    return {
      tier: "DAYAMINERAL PRINCIPIANTE",
      desc: "ESTÁ DANDO SUS PRIMEROS PASOS. RECONOCE ALGUNOS BENEFICIOS, PERO AÚN PUEDE APRENDER MÁS.",
    };
  }

  function createBubble(benefit: Benefit): ActiveBubble {
    const el = document.createElement("div");
    const variant = (Math.floor(Math.random() * 4) + 1);
    el.className = `game-bubble variant-${variant}`;
    el.innerHTML = `
      <img class="bubble-icon" src="${ICON_TOUCH}" alt="touch" />
      <span class="bubble-text">${benefit.text}</span>
    `;
    // Compute size from CSS constants (avoids reading layout while still transitioning)
    const { w, h } = bubbleSize();

    const bubble: ActiveBubble = {
      el,
      benefit,
      x: 0,
      y: 0,
      vx: 0,
      vy: 0,
      w,
      h,
      paused: false,
      locked: false,
      spawning: true,
    };

    if (state.isDesktop) {
      // Compute target position FIRST, set --bx/--by, then add the element to the DOM
      // with the spawn animation already applied. The bubble grows in place at its
      // final coordinates; no off-screen flash, no jump.
      const pf = playfield.getBoundingClientRect();
      const maxX = Math.max(0, pf.width - w);
      const maxY = Math.max(0, pf.height - h);

      let placed = false;
      for (let i = 0; i < 30 && !placed; i++) {
        const x = Math.random() * maxX;
        const y = Math.random() * maxY;
        if (!state.active.some(b => rectsOverlap(x, y, w, h, b.x, b.y, b.w, b.h, 8))) {
          bubble.x = x;
          bubble.y = y;
          placed = true;
        }
      }
      if (!placed) {
        bubble.x = Math.random() * maxX;
        bubble.y = Math.random() * maxY;
      }

      // Slow random velocity
      const angle = Math.random() * Math.PI * 2;
      const speed = 0.12 + Math.random() * 0.10;
      bubble.vx = Math.cos(angle) * speed;
      bubble.vy = Math.sin(angle) * speed;

      // Set position CSS vars BEFORE appending so the @keyframes animation
      // uses the final coordinates from frame 0.
      el.style.setProperty("--bx", `${bubble.x}px`);
      el.style.setProperty("--by", `${bubble.y}px`);
      // Apply initial transform so the bubble starts at its position even before
      // the animation kicks in (covers the gap until the first animation frame).
      el.style.transform = `translate3d(${bubble.x}px, ${bubble.y}px, 0) scale(0.2)`;
      playfield.appendChild(el);

      // Trigger spawn animation on the next frame to ensure the browser
      // registers the initial state first (avoids the animation being skipped).
      requestAnimationFrame(() => el.classList.add("placed"));

      // When the spawn animation finishes, hand control back to the physics loop.
      el.addEventListener(
        "animationend",
        () => {
          bubble.spawning = false;
          el.classList.add("alive");
          // Re-sync transform from current physics state so there's no jump.
          applyTransform(bubble);
        },
        { once: true },
      );
    } else {
      // Mobile column: simple grow-in, no physics
      playfield.appendChild(el);
      requestAnimationFrame(() => el.classList.add("placed"));
      el.addEventListener(
        "animationend",
        () => {
          bubble.spawning = false;
          el.classList.add("alive");
        },
        { once: true },
      );
    }

    el.addEventListener("click", () => onBubbleClick(bubble));
    return bubble;
  }

  function rectsOverlap(
    ax: number, ay: number, aw: number, ah: number,
    bx: number, by: number, bw: number, bh: number,
    pad = 0
  ): boolean {
    return (
      ax < bx + bw + pad &&
      ax + aw + pad > bx &&
      ay < by + bh + pad &&
      ay + ah + pad > by
    );
  }

  function applyTransform(b: ActiveBubble) {
    if (!state.isDesktop) return;
    // Always keep CSS vars in sync (used by spawn/remove animations).
    b.el.style.setProperty("--bx", `${b.x}px`);
    b.el.style.setProperty("--by", `${b.y}px`);
    // Don't fight the spawn keyframes — they own the transform during spawn.
    if (b.spawning) return;
    b.el.style.transform = `translate3d(${b.x}px, ${b.y}px, 0)`;
  }

  function spawnFromPool() {
    while (state.active.length < MAX_VISIBLE && state.pool.length > 0) {
      const benefit = state.pool.shift()!;
      const bubble = createBubble(benefit);
      state.active.push(bubble);
    }
    updateRemainingUI();
  }

  function onBubbleClick(b: ActiveBubble) {
    if (b.locked) return;
    b.locked = true;
    b.paused = true;
    b.vx = 0;
    b.vy = 0;

    if (!state.interactionStarted) {
      state.interactionStarted = true;
      btnFinish.disabled = false;
      btnFinish.classList.remove("opacity-50");
    }

    state.score += b.benefit.points;
    updateScoreUI();

    const isWin = b.benefit.real;
    const pts = Math.abs(b.benefit.points);

    if (isWin) {
      state.found += 1;
      updateFoundUI();
    }

    // Replace content with feedback message, keeping height
    b.el.classList.remove("variant-1", "variant-2", "variant-3", "variant-4");
    b.el.classList.add(isWin ? "feedback-win" : "feedback-lose", "feedback-content");
    b.el.innerHTML = `
      <span class="bubble-text">HA ${isWin ? "GANADO" : "PERDIDO"} ${pts} DAYAPOINTS</span>
    `;

    if (isWin) {
      playSound(audioWin);
      fireConfettiAt(b);
    } else {
      playSound(audioFail);
    }

    // Schedule removal
    setTimeout(() => removeBubble(b), 1200);
  }

  function fireConfettiAt(b: ActiveBubble) {
    try {
      const rect = b.el.getBoundingClientRect();
      const x = (rect.left + rect.width / 2) / window.innerWidth;
      const y = (rect.top + rect.height / 2) / window.innerHeight;
      confetti({
        particleCount: 50,
        spread: 60,
        startVelocity: 35,
        origin: { x, y },
        colors: BRAND_COLORS,
      });
    } catch {}
  }

  function rainConfetti(durationMs = 3000) {
    const end = Date.now() + durationMs;
    (function frame() {
      try {
        confetti({
          particleCount: 6,
          startVelocity: 30,
          spread: 360,
          ticks: 100,
          origin: { x: Math.random(), y: Math.random() * 0.4 },
          colors: BRAND_COLORS,
        });
      } catch {}
      if (Date.now() < end) requestAnimationFrame(frame);
    })();
  }

  function removeBubble(b: ActiveBubble) {
    b.el.classList.add("removing");
    setTimeout(() => {
      b.el.remove();
      const idx = state.active.indexOf(b);
      if (idx >= 0) state.active.splice(idx, 1);

      // End game when all 8 real benefits have been caught
      if (state.found >= 8) {
        finalize();
        return;
      }

      spawnFromPool();
      if (state.pool.length === 0 && state.active.length === 0) {
        finalize();
      }
    }, 350);
  }

  function loop() {
    if (!state.isDesktop) {
      state.rafId = 0;
      return;
    }
    const pf = playfield.getBoundingClientRect();
    const W = pf.width;
    const H = pf.height;

    for (const b of state.active) {
      // Spawning and paused bubbles don't move, but stay as static obstacles.
      if (b.paused || b.spawning) continue;
      b.x += b.vx;
      b.y += b.vy;
      if (b.x < 0) { b.x = 0; b.vx = Math.abs(b.vx); }
      if (b.y < 0) { b.y = 0; b.vy = Math.abs(b.vy); }
      if (b.x + b.w > W) { b.x = W - b.w; b.vx = -Math.abs(b.vx); }
      if (b.y + b.h > H) { b.y = H - b.h; b.vy = -Math.abs(b.vy); }
    }

    // Pairwise collisions — spawning bubbles act as static obstacles
    // (other bubbles bounce off them but the spawning ones don't move).
    for (let i = 0; i < state.active.length; i++) {
      const a = state.active[i];
      for (let j = i + 1; j < state.active.length; j++) {
        const c = state.active[j];
        if (!rectsOverlap(a.x, a.y, a.w, a.h, c.x, c.y, c.w, c.h)) continue;
        const aStatic = a.paused || a.spawning;
        const cStatic = c.paused || c.spawning;
        if (aStatic && cStatic) continue;

        const overlapX = Math.min(a.x + a.w, c.x + c.w) - Math.max(a.x, c.x);
        const overlapY = Math.min(a.y + a.h, c.y + c.h) - Math.max(a.y, c.y);
        if (overlapX < overlapY) {
          // Resolve on X axis
          if (aStatic) {
            // Only c moves; push c fully and flip its vx
            if (c.x < a.x) c.x -= overlapX; else c.x += overlapX;
            c.vx = -c.vx;
          } else if (cStatic) {
            if (a.x < c.x) a.x -= overlapX; else a.x += overlapX;
            a.vx = -a.vx;
          } else {
            const push = overlapX / 2;
            if (a.x < c.x) { a.x -= push; c.x += push; }
            else { a.x += push; c.x -= push; }
            const tmp = a.vx; a.vx = c.vx; c.vx = tmp;
          }
        } else {
          if (aStatic) {
            if (c.y < a.y) c.y -= overlapY; else c.y += overlapY;
            c.vy = -c.vy;
          } else if (cStatic) {
            if (a.y < c.y) a.y -= overlapY; else a.y += overlapY;
            a.vy = -a.vy;
          } else {
            const push = overlapY / 2;
            if (a.y < c.y) { a.y -= push; c.y += push; }
            else { a.y += push; c.y -= push; }
            const tmp = a.vy; a.vy = c.vy; c.vy = tmp;
          }
        }
      }
    }

    for (const b of state.active) applyTransform(b);
    state.rafId = requestAnimationFrame(loop);
  }

  function finalize() {
    cancelAnimationFrame(state.rafId);
    state.rafId = 0;
    const finalScore = Math.max(0, Math.min(100, state.score));
    const t = tierForScore(finalScore);
    tierEl.textContent = t.tier;
    descEl.textContent = t.desc;
    finalScoreEl.textContent = String(finalScore);
    modal.classList.remove("hidden");
    if (finalScore === 100) {
      rainConfetti(3000);
      playSound(audioWin);
    }
  }

  function resetGame() {
    cancelAnimationFrame(state.rafId);
    state.rafId = 0;
    playfield.innerHTML = "";
    state.active = [];
    state.pool = shuffle([...REAL, ...FAKE]);
    state.score = 0;
    state.found = 0;
    state.interactionStarted = false;
    btnFinish.disabled = true;
    btnFinish.classList.add("opacity-50");
    modal.classList.add("hidden");
    updateScoreUI();
    updateRemainingUI();
    updateFoundUI();
    detectMode();
    waitForPlayfieldReady(() => {
      spawnFromPool();
      if (state.isDesktop) state.rafId = requestAnimationFrame(loop);
    });
  }

  // Wait until the playfield has a usable size before placing bubbles.
  // Critical on iPad / Safari where layout settles a few frames after mount.
  function waitForPlayfieldReady(cb: () => void, attempts = 0) {
    const pf = playfield.getBoundingClientRect();
    const { w, h } = bubbleSize();
    const ready = !state.isDesktop || (pf.width >= w * 1.2 && pf.height >= h * 1.2);
    if (ready || attempts > 30) {
      cb();
      return;
    }
    requestAnimationFrame(() => waitForPlayfieldReady(cb, attempts + 1));
  }

  function detectMode() {
    state.isDesktop = window.matchMedia("(min-width: 768px)").matches;
    if (state.isDesktop) {
      playfield.classList.remove("flex", "flex-col", "items-center", "gap-3");
    } else {
      playfield.classList.add("flex", "flex-col", "items-center", "gap-3");
    }
  }

  // Event bindings
  btnRestart.addEventListener("click", () => resetGame());
  btnFinish.addEventListener("click", () => {
    if (btnFinish.disabled) return;
    finalize();
  });
  btnReplay.addEventListener("click", () => resetGame());

  // Handle viewport switches between mobile and desktop
  window.matchMedia("(min-width: 768px)").addEventListener("change", () => {
    resetGame();
  });

  // Repositioning on resize within same mode
  function clampActiveBubblesToPlayfield() {
    if (!state.isDesktop) return;
    const pf = playfield.getBoundingClientRect();
    if (pf.width === 0 || pf.height === 0) return;
    for (const b of state.active) {
      b.x = Math.min(Math.max(0, b.x), Math.max(0, pf.width - b.w));
      b.y = Math.min(Math.max(0, b.y), Math.max(0, pf.height - b.h));
      applyTransform(b);
    }
  }

  window.addEventListener("resize", clampActiveBubblesToPlayfield);

  // ResizeObserver catches container size changes that 'resize' may miss
  // (iPad Safari URL bar collapse/expand, orientation changes, content reflow).
  if (typeof ResizeObserver !== "undefined") {
    const ro = new ResizeObserver(() => clampActiveBubblesToPlayfield());
    ro.observe(playfield);
  }

  // Boot
  resetGame();
</script>
