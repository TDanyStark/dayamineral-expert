---
import { URL_BASE } from "@/config";
---

<script is:inline define:vars={{ URL_BASE }}>
  window.__URL_BASE__ = URL_BASE;
</script>

<section
  id="game-root"
  class="relative w-full min-h-screen pt-28 md:pt-32 pb-8 px-4"
>
  <!-- Status bar -->
  <div
    class="relative z-20 max-w-7xl mx-auto mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-3"
  >
    <div class="flex items-center gap-4 text-white">
      <div
        class="bg-white/15 backdrop-blur-md border border-white/20 rounded-full px-5 py-2"
      >
        <span class="text-sm md:text-base font-light">DAYAPOINTS:</span>
        <span class="text-lg md:text-xl font-bold ml-1" id="game-score">000</span>
      </div>
      <div
        class="bg-white/15 backdrop-blur-md border border-white/20 rounded-full px-5 py-2"
      >
        <span class="text-sm md:text-base font-light">FALTAN:</span>
        <span class="text-lg md:text-xl font-bold ml-1" id="game-remaining">15</span>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <button
        id="game-btn-restart"
        type="button"
        class="text-white text-sm md:text-base font-bold py-2 px-5 rounded-full bg-white/15 hover:bg-white/25 backdrop-blur-md border border-white/30 transition"
      >
        REINICIAR
      </button>
      <button
        id="game-btn-finish"
        type="button"
        disabled
        class="text-white text-sm md:text-base font-bold py-2 px-5 rounded-full bg-linear-(--gradient-purple) opacity-50 disabled:cursor-not-allowed hover:opacity-100 enabled:opacity-100 transition"
      >
        FINALIZAR
      </button>
    </div>
  </div>

  <!-- Playfield -->
  <div
    id="game-playfield"
    class="relative w-full max-w-7xl mx-auto flex flex-col items-center gap-3 md:block md:gap-0"
    style="min-height: 60vh;"
  >
  </div>

  <!-- Hidden audio -->
  <audio id="game-audio-win" src={`${URL_BASE}/sounds/confetti.mp3`} preload="auto"></audio>
  <audio id="game-audio-fail" src={`${URL_BASE}/sounds/fail.mp3`} preload="auto"></audio>

  <!-- Final modal -->
  <div
    id="game-final-modal"
    class="fixed inset-0 z-50 hidden bg-black/70"
  >
    <div
      class="absolute inset-0 bg-no-repeat bg-cover bg-center"
      style={`background-image: url(${URL_BASE}/images/bg_end.webp);`}
    >
    </div>

    <div class="relative z-10 w-full h-full flex flex-col">
      <!-- modal header -->
      <div class="w-7xl max-w-full mx-auto p-4 md:p-6 flex justify-between items-center">
        <img
          src={`${URL_BASE}/logos/abbott_white.webp`}
          alt="Logo Abbott"
          class="w-24 md:w-32"
        />
        <img
          src={`${URL_BASE}/logos/logo_dayamineral_color.webp`}
          alt="Logo Dayamineral"
          class="w-32 md:w-44"
        />
      </div>

      <!-- modal content -->
      <div
        class="flex-1 flex items-center justify-center md:justify-end px-6 md:pr-16 lg:pr-24"
      >
        <div class="w-full max-w-xl text-white text-center md:text-left">
          <div class="mb-4 md:mb-6">
            <span
              id="game-final-badge"
              class="inline-flex items-center gap-3 bg-linear-(--gradient-purple) text-white font-bold py-3 px-6 rounded-full text-2xl md:text-4xl"
            >
              <img
                src={`${URL_BASE}/iconos/icon_padlock.webp`}
                alt="badge icon"
                class="w-7 h-7 md:w-9 md:h-9"
              />
              <span id="game-final-tier">DAYAMINERAL EXPERT</span>
            </span>
          </div>
          <p
            id="game-final-description"
            class="text-lg md:text-2xl uppercase leading-snug mb-4"
          >
          </p>
          <p class="text-xl md:text-2xl font-bold mb-6">
            DAYAPOINTS: <span id="game-final-score">0</span>
          </p>
          <button
            id="game-btn-replay"
            type="button"
            class="text-white text-xl md:text-2xl font-bold py-3 px-6 rounded-full bg-linear-(--gradient-purple) transition-transform transform hover:scale-105"
          >
            JUGAR DE NUEVO
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .game-bubble {
    width: 15rem;
    height: 7.5rem;
    border-radius: 1.5rem;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      inset 0 -1px 0 rgba(255, 255, 255, 0.08),
      0 8px 24px rgba(0, 0, 0, 0.18);
    color: #ffffff;
    padding: 0.85rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    cursor: pointer;
    user-select: none;
    text-transform: uppercase;
    font-family: "Brandon", sans-serif;
    font-size: 0.82rem;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: 0.01em;
    overflow: hidden;
    transition: opacity 0.35s ease, transform 0.2s ease, box-shadow 0.2s ease;
    will-change: transform;
  }

  .game-bubble:hover {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.45),
      0 12px 30px rgba(0, 0, 0, 0.25);
  }

  .game-bubble.variant-1 {
    background: linear-gradient(135deg, rgba(253, 0, 21, 0.32), rgba(255, 255, 255, 0.14));
  }
  .game-bubble.variant-2 {
    background: linear-gradient(135deg, rgba(174, 0, 97, 0.36), rgba(255, 255, 255, 0.12));
  }
  .game-bubble.variant-3 {
    background: linear-gradient(135deg, rgba(222, 138, 23, 0.28), rgba(174, 0, 97, 0.22));
  }
  .game-bubble.variant-4 {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.22), rgba(174, 0, 97, 0.16));
  }

  .game-bubble .bubble-icon {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.25));
  }

  .game-bubble .bubble-text {
    flex: 1;
    color: #ffffff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  }

  .game-bubble.feedback-win {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.6), rgba(34, 197, 94, 0.28));
    border-color: rgba(255, 255, 255, 0.6);
  }
  .game-bubble.feedback-lose {
    background: linear-gradient(135deg, rgba(253, 0, 21, 0.6), rgba(174, 0, 97, 0.4));
    border-color: rgba(255, 255, 255, 0.6);
  }

  .game-bubble.feedback-content {
    justify-content: center;
    text-align: center;
  }

  .game-bubble.feedback-content .bubble-text {
    font-size: 1.05rem;
    font-weight: 900;
    letter-spacing: 0.02em;
  }

  .game-bubble.removing {
    opacity: 0;
    transform: scale(0.85) translate3d(var(--bx, 0), var(--by, 0), 0);
  }

  /* Desktop free-floating */
  @media (min-width: 768px) {
    #game-playfield {
      height: 70vh;
      min-height: 520px;
    }
    .game-bubble {
      position: absolute;
      top: 0;
      left: 0;
    }
    .game-bubble.removing {
      transform: scale(0.85) translate3d(var(--bx, 0), var(--by, 0), 0);
    }
  }

  /* Mobile column */
  @media (max-width: 767px) {
    .game-bubble {
      position: relative;
      transform: none !important;
      width: 90%;
      max-width: 22rem;
    }
  }
</style>

<script>
  import confetti from "canvas-confetti";

  type Benefit = { text: string; points: number; real: boolean };

  const REAL: Benefit[] = [
    { text: "TRIPLE IMPULSO (ENERGÍA, VITALIDAD, DESEMPEÑO FÍSICO Y MENTAL).", points: 18, real: true },
    { text: "FORTALECE LAS DEFENSAS DE LOS NIÑOS.", points: 15, real: true },
    { text: "MEJORA EL DESARROLLO FÍSICO Y CEREBRAL DE LOS NIÑOS.", points: 15, real: true },
    { text: "MEJORA MEMORIA Y CONCENTRACIÓN.", points: 12, real: true },
    { text: "AUMENTA METABOLISMO Y OXIGENACIÓN.", points: 12, real: true },
    { text: "MEJORA RENDIMIENTO FÍSICO.", points: 10, real: true },
    { text: "MANTIENE ÓPTIMAS LAS FUNCIONES INMUNE Y MUSCULAR.", points: 10, real: true },
    { text: "BENEFICIOS SIN AUMENTO DE PESO.", points: 8, real: true },
  ];

  const FAKE: Benefit[] = [
    { text: "PERMITE QUE LOS NIÑOS HAGAN TAREAS SIN PROTESTAR.", points: -8, real: false },
    { text: "AUMENTA LA VELOCIDAD PARA APRENDER A MONTAR BICICLETA.", points: -7, real: false },
    { text: "HACE QUE LOS ALIMENTOS SEPAN MÁS DELICIOSOS.", points: -7, real: false },
    { text: "PERMITE QUE LOS NIÑOS NUNCA SE RESFRÍEN.", points: -10, real: false },
    { text: "MEJORA LA HABILIDAD PARA GANAR VIDEOJUEGOS.", points: -8, real: false },
    { text: "HACE QUE LAS REUNIONES LABORALES SEAN MÁS EFICIENTES.", points: -5, real: false },
    { text: "POTENCIALIZA LOS EFECTOS DEL CAFÉ PARA EVITAR EL SUEÑO EN LAS TARDES.", points: -5, real: false },
  ];

  const MAX_VISIBLE = 8;
  const URL_BASE = (window as any).__URL_BASE__ ?? "/apps/abbott/dayamineral-expert";
  const ICON_TOUCH = `${URL_BASE}/iconos/icon_touch.webp`;

  type ActiveBubble = {
    el: HTMLDivElement;
    benefit: Benefit;
    x: number;
    y: number;
    vx: number;
    vy: number;
    w: number;
    h: number;
    paused: boolean;
    locked: boolean;
  };

  const state = {
    pool: [] as Benefit[],
    active: [] as ActiveBubble[],
    score: 0,
    interactionStarted: false,
    rafId: 0,
    isDesktop: false,
  };

  const playfield = document.getElementById("game-playfield") as HTMLDivElement;
  const scoreEl = document.getElementById("game-score") as HTMLSpanElement;
  const remainingEl = document.getElementById("game-remaining") as HTMLSpanElement;
  const btnRestart = document.getElementById("game-btn-restart") as HTMLButtonElement;
  const btnFinish = document.getElementById("game-btn-finish") as HTMLButtonElement;
  const btnReplay = document.getElementById("game-btn-replay") as HTMLButtonElement;
  const modal = document.getElementById("game-final-modal") as HTMLDivElement;
  const tierEl = document.getElementById("game-final-tier") as HTMLSpanElement;
  const descEl = document.getElementById("game-final-description") as HTMLParagraphElement;
  const finalScoreEl = document.getElementById("game-final-score") as HTMLSpanElement;
  const audioWin = document.getElementById("game-audio-win") as HTMLAudioElement;
  const audioFail = document.getElementById("game-audio-fail") as HTMLAudioElement;

  const BRAND_COLORS = ["#de8a17", "#fd0015", "#ae0061", "#ffffff"];

  function shuffle<T>(arr: T[]): T[] {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function updateScoreUI() {
    const display = Math.max(0, state.score);
    scoreEl.textContent = String(display).padStart(3, "0");
  }

  function updateRemainingUI() {
    const total = state.pool.length + state.active.length;
    remainingEl.textContent = String(total);
  }

  function tierForScore(score: number): { tier: string; desc: string } {
    if (score >= 100) {
      return {
        tier: "DAYAMINERAL EXPERT",
        desc: "DOMINIO TOTAL. CONOCE A LA PERFECCIÓN LOS BENEFICIOS QUE LE BRINDA DAYAMINERAL.",
      };
    }
    if (score >= 61) {
      return {
        tier: "DAYAMINERAL ADVANCED",
        desc: "DEMUESTRA UN CONOCIMIENTO AVANZADO. ESTÁ MUY CERCA DE LLEGAR AL NIVEL EXPERT.",
      };
    }
    if (score >= 31) {
      return {
        tier: "DAYAMINERAL MEDIUM",
        desc: "TIENE UNA BUENA BASE, AUNQUE TODAVÍA SE LE ESCAPAN DETALLES CLAVE. VA POR MUY BUEN CAMINO.",
      };
    }
    return {
      tier: "DAYAMINERAL PRINCIPIANTE",
      desc: "ESTÁ DANDO SUS PRIMEROS PASOS. RECONOCE ALGUNOS BENEFICIOS, PERO AÚN PUEDE APRENDER MÁS.",
    };
  }

  function createBubble(benefit: Benefit): ActiveBubble {
    const el = document.createElement("div");
    const variant = (Math.floor(Math.random() * 4) + 1);
    el.className = `game-bubble variant-${variant}`;
    el.innerHTML = `
      <img class="bubble-icon" src="${ICON_TOUCH}" alt="touch" />
      <span class="bubble-text">${benefit.text}</span>
    `;
    playfield.appendChild(el);

    // Measure (bubble has fixed size via CSS but we read it for safety)
    const rect = el.getBoundingClientRect();
    const w = rect.width || 224;
    const h = rect.height || 112;

    const bubble: ActiveBubble = {
      el,
      benefit,
      x: 0,
      y: 0,
      vx: 0,
      vy: 0,
      w,
      h,
      paused: false,
      locked: false,
    };

    if (state.isDesktop) {
      const pf = playfield.getBoundingClientRect();
      const maxX = Math.max(0, pf.width - w);
      const maxY = Math.max(0, pf.height - h);
      // Try non-overlapping placement (best effort)
      let placed = false;
      for (let i = 0; i < 30 && !placed; i++) {
        const x = Math.random() * maxX;
        const y = Math.random() * maxY;
        if (!state.active.some(b => rectsOverlap(x, y, w, h, b.x, b.y, b.w, b.h, 8))) {
          bubble.x = x;
          bubble.y = y;
          placed = true;
        }
      }
      if (!placed) {
        bubble.x = Math.random() * maxX;
        bubble.y = Math.random() * maxY;
      }
      // Slow random velocity
      const angle = Math.random() * Math.PI * 2;
      const speed = 0.12 + Math.random() * 0.10;
      bubble.vx = Math.cos(angle) * speed;
      bubble.vy = Math.sin(angle) * speed;
      applyTransform(bubble);
    }

    el.addEventListener("click", () => onBubbleClick(bubble));
    return bubble;
  }

  function rectsOverlap(
    ax: number, ay: number, aw: number, ah: number,
    bx: number, by: number, bw: number, bh: number,
    pad = 0
  ): boolean {
    return (
      ax < bx + bw + pad &&
      ax + aw + pad > bx &&
      ay < by + bh + pad &&
      ay + ah + pad > by
    );
  }

  function applyTransform(b: ActiveBubble) {
    if (!state.isDesktop) return;
    b.el.style.transform = `translate3d(${b.x}px, ${b.y}px, 0)`;
    b.el.style.setProperty("--bx", `${b.x}px`);
    b.el.style.setProperty("--by", `${b.y}px`);
  }

  function spawnFromPool() {
    while (state.active.length < MAX_VISIBLE && state.pool.length > 0) {
      const benefit = state.pool.shift()!;
      const bubble = createBubble(benefit);
      state.active.push(bubble);
    }
    updateRemainingUI();
  }

  function onBubbleClick(b: ActiveBubble) {
    if (b.locked) return;
    b.locked = true;
    b.paused = true;
    b.vx = 0;
    b.vy = 0;

    if (!state.interactionStarted) {
      state.interactionStarted = true;
      btnFinish.disabled = false;
      btnFinish.classList.remove("opacity-50");
    }

    state.score += b.benefit.points;
    const display = Math.max(0, state.score);
    updateScoreUI();

    const isWin = b.benefit.real;
    const pts = Math.abs(b.benefit.points);

    // Replace content with feedback message, keeping height
    b.el.classList.remove("variant-1", "variant-2", "variant-3", "variant-4");
    b.el.classList.add(isWin ? "feedback-win" : "feedback-lose", "feedback-content");
    b.el.innerHTML = `
      <span class="bubble-text">HA ${isWin ? "GANADO" : "PERDIDO"} ${pts} DAYAPOINTS</span>
    `;

    if (isWin) {
      try { audioWin.currentTime = 0; audioWin.play().catch(() => {}); } catch {}
      fireConfettiAt(b);
    } else {
      try { audioFail.currentTime = 0; audioFail.play().catch(() => {}); } catch {}
    }

    // Schedule removal
    setTimeout(() => removeBubble(b), 1200);
  }

  function fireConfettiAt(b: ActiveBubble) {
    try {
      const rect = b.el.getBoundingClientRect();
      const x = (rect.left + rect.width / 2) / window.innerWidth;
      const y = (rect.top + rect.height / 2) / window.innerHeight;
      confetti({
        particleCount: 50,
        spread: 60,
        startVelocity: 35,
        origin: { x, y },
        colors: BRAND_COLORS,
      });
    } catch {}
  }

  function rainConfetti(durationMs = 3000) {
    const end = Date.now() + durationMs;
    (function frame() {
      try {
        confetti({
          particleCount: 6,
          startVelocity: 30,
          spread: 360,
          ticks: 100,
          origin: { x: Math.random(), y: Math.random() * 0.4 },
          colors: BRAND_COLORS,
        });
      } catch {}
      if (Date.now() < end) requestAnimationFrame(frame);
    })();
  }

  function removeBubble(b: ActiveBubble) {
    b.el.classList.add("removing");
    setTimeout(() => {
      b.el.remove();
      const idx = state.active.indexOf(b);
      if (idx >= 0) state.active.splice(idx, 1);
      spawnFromPool();
      if (state.pool.length === 0 && state.active.length === 0) {
        finalize();
      }
    }, 350);
  }

  function loop() {
    if (!state.isDesktop) {
      state.rafId = 0;
      return;
    }
    const pf = playfield.getBoundingClientRect();
    const W = pf.width;
    const H = pf.height;

    for (const b of state.active) {
      if (b.paused) continue;
      b.x += b.vx;
      b.y += b.vy;
      if (b.x < 0) { b.x = 0; b.vx = Math.abs(b.vx); }
      if (b.y < 0) { b.y = 0; b.vy = Math.abs(b.vy); }
      if (b.x + b.w > W) { b.x = W - b.w; b.vx = -Math.abs(b.vx); }
      if (b.y + b.h > H) { b.y = H - b.h; b.vy = -Math.abs(b.vy); }
    }

    // Pairwise collisions
    for (let i = 0; i < state.active.length; i++) {
      const a = state.active[i];
      if (a.paused) continue;
      for (let j = i + 1; j < state.active.length; j++) {
        const c = state.active[j];
        if (c.paused) continue;
        if (rectsOverlap(a.x, a.y, a.w, a.h, c.x, c.y, c.w, c.h)) {
          // Compute overlap on each axis
          const overlapX = Math.min(a.x + a.w, c.x + c.w) - Math.max(a.x, c.x);
          const overlapY = Math.min(a.y + a.h, c.y + c.h) - Math.max(a.y, c.y);
          if (overlapX < overlapY) {
            // Resolve on X axis
            const push = overlapX / 2;
            if (a.x < c.x) { a.x -= push; c.x += push; }
            else { a.x += push; c.x -= push; }
            const tmp = a.vx; a.vx = c.vx; c.vx = tmp;
          } else {
            const push = overlapY / 2;
            if (a.y < c.y) { a.y -= push; c.y += push; }
            else { a.y += push; c.y -= push; }
            const tmp = a.vy; a.vy = c.vy; c.vy = tmp;
          }
        }
      }
    }

    for (const b of state.active) applyTransform(b);
    state.rafId = requestAnimationFrame(loop);
  }

  function finalize() {
    cancelAnimationFrame(state.rafId);
    state.rafId = 0;
    const finalScore = Math.max(0, Math.min(100, state.score));
    const t = tierForScore(finalScore);
    tierEl.textContent = t.tier;
    descEl.textContent = t.desc;
    finalScoreEl.textContent = String(finalScore);
    modal.classList.remove("hidden");
    if (finalScore === 100) {
      rainConfetti(3000);
      try { audioWin.currentTime = 0; audioWin.play().catch(() => {}); } catch {}
    }
  }

  function resetGame() {
    cancelAnimationFrame(state.rafId);
    state.rafId = 0;
    playfield.innerHTML = "";
    state.active = [];
    state.pool = shuffle([...REAL, ...FAKE]);
    state.score = 0;
    state.interactionStarted = false;
    btnFinish.disabled = true;
    btnFinish.classList.add("opacity-50");
    modal.classList.add("hidden");
    updateScoreUI();
    updateRemainingUI();
    detectMode();
    spawnFromPool();
    if (state.isDesktop) state.rafId = requestAnimationFrame(loop);
  }

  function detectMode() {
    state.isDesktop = window.matchMedia("(min-width: 768px)").matches;
    if (state.isDesktop) {
      playfield.classList.remove("flex", "flex-col", "items-center", "gap-3");
    } else {
      playfield.classList.add("flex", "flex-col", "items-center", "gap-3");
    }
  }

  // Event bindings
  btnRestart.addEventListener("click", () => resetGame());
  btnFinish.addEventListener("click", () => {
    if (btnFinish.disabled) return;
    finalize();
  });
  btnReplay.addEventListener("click", () => resetGame());

  // Handle viewport switches between mobile and desktop
  window.matchMedia("(min-width: 768px)").addEventListener("change", () => {
    resetGame();
  });

  // Repositioning on resize within same mode
  window.addEventListener("resize", () => {
    if (!state.isDesktop) return;
    const pf = playfield.getBoundingClientRect();
    for (const b of state.active) {
      b.x = Math.min(b.x, Math.max(0, pf.width - b.w));
      b.y = Math.min(b.y, Math.max(0, pf.height - b.h));
      applyTransform(b);
    }
  });

  // Boot
  resetGame();
</script>
